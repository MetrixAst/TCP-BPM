# Django (production defaults — copy to .env and adjust)
SECRET_KEY=change-me-in-production
DEBUG=False
ALLOWED_HOSTS=your-domain.com,localhost,53e2-92-47-222-87.ngrok-free.app
TRUSTED_ORIGINS=https://your-domain.com,https://53e2-92-47-222-87.ngrok-free.app

# PostgreSQL
POSTGRES_ENGINE=django.db.backends.postgresql
POSTGRES_DB=trc_bpm
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE=postgres

# Celery
CELERY_BROKER_URL=redis://redis:6379/0

# Timezone
TZ=Asia/Almaty

# 1C Integration
ONEC_URL=http://your-1c-server/api/
ALTERNATE_ONEC_URL=http://your-1c-alt-server/api/
ONE_C_BASE_URL=https://your-1c-server/hs/api/v1
ONE_C_BASIC_AUTH_USER=Admin
ONE_C_BASIC_AUTH_PASSWORD=your-password
ONE_C_API_USER=admin
ONE_C_API_PASSWORD=your-password
ONE_C_SYNC_ENABLED=True
ONE_C_SYNC_SINCE_DAYS=90

# SMTP (счета, уведомления арендаторам)
# Cloud24: mail.cloud24.kz:587 + TLS | M365: smtp.office365.com:587 + TLS
EMAIL_HOST=mail.cloud24.kz
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=noreply@your-domain.com
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@your-domain.com
# Ссылка на вход в письмах арендаторам
PUBLIC_SITE_URL=https://94-131-230-101.sslip.io
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# Проверка: python manage.py send_test_email you@example.com

# Ручной запуск синхронизации: python manage.py sync_onec
# Celery (каждые 4 ч): sync_counterparties_task + sync_onec_all_task

# ONLYOFFICE Document Server (серверное редактирование документов)
# Сервер уже поднят (общий для проекта). Браузер грузит api.js отсюда:
ONLYOFFICE_DS_PUBLIC_URL=https://office.metrix.com.ai
# Адрес Django, доступный Document Server'у (DS внешний → ДОЛЖЕН быть публичным,
# отдавать /media без авторизации). Прод: https://<ваш-домен>. Пусто — из запроса.
ONLYOFFICE_BACKEND_INTERNAL_URL=
# Общий JWT-секрет с Document Server (тот же, что задан на DS).
ONLYOFFICE_JWT_SECRET=s4x3XgJV8c6CwHlgu3WkUEdaiTwGjdBW
ONLYOFFICE_JWT_ENABLED=True
# Дополнительные разрешённые хосты скачивания callback, через запятую.
ONLYOFFICE_ALLOWED_DOWNLOAD_HOSTS=

# eSigner (ЭЦП, Казахстан)
ESIGNER_URL=https://esigner.kz/back
ESIGNER_SIGN_BASE_URL=https://sign.avantage.one
ESIGNER_CLIENT_ID=
ESIGNER_SECRET_KEY=
ESIGNER_COMPANY_ID=0
ESIGNER_FOLDER_ID=
ESIGNER_TIMEOUT=30
# Секрет для Authorization: Bearer ... или HMAC X-ESigner-Signature webhook.
ESIGNER_WEBHOOK_SECRET=
