DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/invoice


ENVIRONMENT=production
SECRET_KEY=change-me-long-random-string
SUPER_ADMIN_USERNAME=super_metrix
SUPER_ADMIN_PASSWORD=


CORS_ORIGINS=["http://localhost:3003","http://localhost:5173","http://127.0.0.1:3003","http://127.0.0.1:5173"]

# Файлы на диске (общий PVC на все pod invoice-api и invoice-worker)
# Печать и подпись арендаторов (PDF счёта)
TENANT_UPLOADS_DIR=/app/uploads/tenants
# Буфер PDF перед отправкой WhatsApp через Kafka (API кладёт, worker читает)
WHATSAPP_OUTBOX_DIR=/app/uploads/outbox

# 1С OData (дефолты; у tenant в админке свои one_c_*)
ONE_C_BASE_URL=https://example.irm.kz/tgb/hs/api/v1
ONE_C_BASIC_AUTH_USER=
ONE_C_BASIC_AUTH_PASSWORD=
ONE_C_API_USER=
ONE_C_API_PASSWORD=
ONE_C_ODATA_COUNTERPARTY_ENTITIES=
ONE_C_ODATA_INVOICE_ENTITIES=

# Nova COM/MCP (tenant.nova_organization_id — в админке)
NOVA_BACKEND_URL=https://backend.mynova.kz
NOVA_ADMIN_EMAIL=
NOVA_ADMIN_PASSWORD=
NOVA_MCP_RELAY_URL=https://rk.mcp.uzun.kz
NOVA_MCP_RELAY_API_KEY=
NOVA_COM_PORTAL_PDF_FALLBACK=false

# --- Green API (дефолты; у tenant/TRC ключи в БД) ---
GREEN_API_URL=https://api.greenapi.com
GREEN_API_MEDIA_URL=https://media.greenapi.com
GREEN_API_ID_INSTANCE=
GREEN_API_API_TOKEN=
GREEN_API_TEST_ID_INSTANCE=
GREEN_API_TEST_API_TOKEN=

# Kafka
KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=kafka-cluster-kafka-bootstrap.default.svc.cluster.local:9092
KAFKA_SECURITY_PROTOCOL=SASL_PLAINTEXT
KAFKA_SASL_MECHANISM=PLAIN
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_TOPIC_WHATSAPP=invoice.whatsapp.send
KAFKA_TOPIC_WEBHOOK=invoice.webhooks.incoming
KAFKA_TOPIC_PAYMENTS_SYNC=invoice.payments.sync
KAFKA_CONSUMER_GROUP=invoice-registry-workers



JWT_ALGORITHM=HS256
ADMIN_TOKEN_EXPIRE_MINUTES=1440



# [ ] DATABASE_URL из Secret (не bake в Docker-образ)
# [ ] TENANT_UPLOADS_DIR + WHATSAPP_OUTBOX_DIR — один PVC, mount на api + worker
# [ ] NOVA_* + NOVA_MCP_RELAY_* для COM/OData PDF
# [ ] CORS_ORIGINS для окружения
# front_admin build: VITE_API_URL=https://api.invoice.metrix.com.ai
# frontend build:    NEXT_PUBLIC_API_URL=https://api.invoice.metrix.com.ai
