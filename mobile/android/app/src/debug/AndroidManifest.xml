<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Debug builds only: allow plain http:// so the app can reach a local
         dev backend (e.g. BASE_URL=http://10.0.2.2:8000 on the Android
         emulator). Android blocks cleartext traffic by default since API 28.
         Release builds must keep using https:// and are unaffected. -->
    <application android:usesCleartextTraffic="true" />
</manifest>
